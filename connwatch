write_own() {
  "$IFCONFIG" -a 2>/dev/null | "$AWK" '
    $1 == "inet" || $1 == "inet6" {
      addr = $2
      sub(/%.*/, "", addr)
      if (addr != "") print tolower(addr)
      for (i = 1; i < NF; i++) if ($i == "broadcast") print tolower($(i + 1))
    }
  ' > "$own_file.tmp"
  mv -f "$own_file.tmp" "$own_file"
}

# На pktap Apple не собирает BPF-фильтр (DLT_PKTAP). Поэтому фильтр
# вешается на обычные интерфейсы: en*, bridge*, utun* и другие туннели.
list_capture_ifaces() {
  local iface
  for iface in $("$IFCONFIG" -lu); do
    case "$iface" in
      en*|bridge*|utun*|ipsec*|ppp*|vlan*)
        printf '%s\n' "$iface"
        ;;
    esac
  done
}

probe_iface() {
  local iface="$1" directed="$2"
  local -a cmd
  cmd=("$TCPDUMP" -d -n -p)
  [[ "$directed" -eq 1 ]] && cmd+=(--direction=out)
  cmd+=(-i "$iface" "$FILTER")
  "${cmd[@]}" >/dev/null 2>"$errlog"
}

probe_pktap() {
  local directed="$1"
  local -a cmd
  cmd=("$TCPDUMP" -d -n -p)
  [[ "$directed" -eq 1 ]] && cmd+=(--direction=out)
  cmd+=(-i pktap,all)
  "${cmd[@]}" >/dev/null 2>"$errlog"
}

choose_capture() {
  local iface
  capture_mode=ifaces
  awk_outbound_only=0
  while IFS= read -r iface; do
    [[ -z "$iface" ]] && continue
    # Ответ DNS приходит навстречу, поэтому направление «только исходящие» не включаем.
    if probe_iface "$iface" 0; then
      return 0
    fi
  done < <(list_capture_ifaces)

  capture_mode=pktap
  awk_outbound_only=0
  if probe_pktap 0; then
    echo "На pktap нет BPF-фильтра: отбираю TCP SYN и DNS по локальным адресам." >&2
    return 0
  fi
  echo "Не удалось подготовить захват пакетов." >&2
  cat "$errlog" >&2
  exit 1
}

launch_tcpdump() {
  local iface="$1" directed="$2"
  local -a cmd
  cmd=("$TCPDUMP" -n -l -p --immediate-mode)
  [[ "$directed" -eq 1 ]] && cmd+=(--direction=out)
  cmd+=(-i "$iface")
  if [[ "$capture_mode" == ifaces ]]; then
    cmd+=("$FILTER")
  fi
  exec "${cmd[@]}" 2>>"$errlog"
}

any_capture_alive() {
  local f pid
  for f in "$piddir"/*.pid; do
    [[ -e "$f" ]] || continue
    pid=$(cat "$f" 2>/dev/null || true)
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

supervise_ifaces() {
  local iface directed first=1
  local -a started
  started=()
  : > "$seen_file"
  while true; do
    while IFS= read -r iface; do
      [[ -z "$iface" ]] && continue
      if grep -qxF "$iface" "$seen_file" 2>/dev/null; then
        continue
      fi
      directed=0
      if ! probe_iface "$iface" 0; then
        echo "$iface" >> "$seen_file"
        continue
      fi
      echo "$iface" >> "$seen_file"
      launch_tcpdump "$iface" "$directed" &
      echo $! > "$piddir/${iface}.pid"
      started+=("$iface")
    done < <(list_capture_ifaces)
    if [[ "$first" -eq 1 ]]; then
      first=0
      sleep 1
      if ! any_capture_alive; then
        echo "Не удалось начать захват на интерфейсах." >&2
        exit 1
      fi
      echo "Слушаю: ${started[*]}" >&2
    fi
    sleep 2
  done
}

start_pktap() {
  local -a cmd
  cmd=("$TCPDUMP" -n -l -p --immediate-mode)
  cmd+=(-i pktap,all)
  "${cmd[@]}"
}

watch_cleanup() {
  local f pid
  [[ -n "$own_pid" ]] && kill "$own_pid" 2>/dev/null || true
  [[ -n "$own_pid" ]] && wait "$own_pid" 2>/dev/null || true
  if [[ -n "$piddir" && -d "$piddir" ]]; then
    for f in "$piddir"/*.pid; do
      [[ -e "$f" ]] || continue
      pid=$(cat "$f" 2>/dev/null || true)
      [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    done
    rm -rf "$piddir"
  fi
  [[ -n "$own_file" ]] && rm -f "$own_file" "$own_file.tmp"
  [[ -n "$errlog" ]] && rm -f "$errlog"
}

watch_main() {
  local td_rc awk_rc
  if [[ "$(id -u)" -ne 0 ]]; then
    if [[ -n "$fqdn_file" ]]; then
      fqdn_file=$(expand_fqdn_path "$fqdn_file")
      prepare_fqdn_file
      exec "$SUDO" -p "Нужен пароль администратора, чтобы смотреть исходящие соединения этого Mac: " -- "$0" -o "$fqdn_file"
    fi
    exec "$SUDO" -p "Нужен пароль администратора, чтобы смотреть исходящие соединения этого Mac: " -- "$0"
  fi

  if [[ -n "$fqdn_file" ]]; then
    fqdn_file=$(expand_fqdn_path "$fqdn_file")
    prepare_fqdn_file
  fi

  own_file=$(mktemp "${TMPDIR:-/tmp}/connwatch.own.XXXXXX")
  errlog=$(mktemp "${TMPDIR:-/tmp}/connwatch.err.XXXXXX")
  piddir=$(mktemp -d "${TMPDIR:-/tmp}/connwatch.pids.XXXXXX")
  seen_file="$piddir/seen"
  trap watch_cleanup EXIT
  trap 'exit 0' INT TERM

  choose_capture
  write_own
  local_file="$own_file"
  use_direction=$awk_outbound_only
  (
    trap - EXIT INT TERM
    while true; do
      write_own || true
      sleep 2
    done
  ) &
  own_pid=$!

  echo "Новые исходящие TCP с этого момента, каждый IP один раз. Ctrl-C — стоп." >&2
  echo "Loopback и multicast не печатаю. UDP/QUIC без TCP не печатаю. Через HTTP-прокси виден адрес прокси." >&2
  if [[ -n "$fqdn_file" ]]; then
    echo "Файл пар очищен: dns, имя, IP. Прямой TCP без ответа DNS: direct, -, IP. Поля через TAB." >&2
    echo "$fqdn_file" >&2
  fi

  set +e
  if [[ "$capture_mode" == pktap ]]; then
    start_pktap 2>>"$errlog" | run_awk
  else
    supervise_ifaces | run_awk
  fi
  td_rc=${PIPESTATUS[0]}
  awk_rc=${PIPESTATUS[1]}
  set -e
  if [[ "$awk_rc" -ne 0 && "$awk_rc" -ne 141 ]]; then
    echo "разбор вывода tcpdump завершился с кодом $awk_rc" >&2
    exit "$awk_rc"
  fi
  if [[ "$td_rc" -ne 0 && "$td_rc" -ne 130 && "$td_rc" -ne 141 && "$td_rc" -ne 2 ]]; then
    echo "tcpdump завершился с кодом $td_rc" >&2
    [[ -s "$errlog" ]] && cat "$errlog" >&2
    exit "$td_rc"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --check)
      mode=check
      shift
      ;;
    --parse)
      mode=parse
      shift
      ;;
    -o)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "ключ -o требует путь к файлу" >&2
        exit 2
      fi
      fqdn_file=$2
      shift 2
      ;;
    *)
      echo "неизвестный аргумент: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$mode" in
  check)
    run_check
    ;;
  parse)
    if [[ -n "$fqdn_file" ]]; then
      fqdn_file=$(expand_fqdn_path "$fqdn_file")
      prepare_fqdn_file
    fi
    use_direction=${OUTBOUND_ONLY:-0}
    local_file=${LOCAL_FILE:-}
    run_awk
    ;;
  watch)
    watch_main
    ;;
esac
