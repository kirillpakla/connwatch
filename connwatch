#!/bin/bash
# Наблюдение за своим Mac с момента запуска.
# stdout: уникальные IP новых исходящих TCP-соединений, по одному в строке.
# -o файл: TAB-записи «dns <имя> <ip>» и «direct - <ip>».
# direct — TCP-адрес, которого не было в увиденном ответе DNS.
# Захват без promiscuous mode. Чужой трафик в сегменте не читается.

set -euo pipefail
export LC_ALL=C

TCPDUMP=/usr/sbin/tcpdump
AWK=/usr/bin/awk
IFCONFIG=/sbin/ifconfig
SUDO=/usr/bin/sudo

FILTER='((tcp[tcpflags] & tcp-syn != 0) and (tcp[tcpflags] & tcp-ack == 0)) or port 53'

name=$(basename -- "$0")
mode=watch
fqdn_file=""
use_direction=1
capture_mode=""
awk_outbound_only=0
local_file=""
own_file=""
own_pid=""
errlog=""
piddir=""
seen_file=""

usage() {
  cat <<EOF
Использование: $name [-o файл]

Печатает в столбик IP новых исходящих TCP-соединений с момента запуска.
Каждый адрес выводится один раз.

  -o файл   очистить файл и писать в него строки из трёх полей через TAB:
            dns, имя, IP — адрес из ответа DNS на это имя;
            direct, -, IP — исходящий TCP без такого ответа.
            У одного имени бывает несколько строк, по адресу на строку.

Нужны права администратора на захват пакетов этого Mac. Скрипт сам
вызывает sudo. Останов: Ctrl-C.

Не попадает в столбец: соединения, открытые до запуска; loopback и multicast;
UDP и QUIC, если рядом нет TCP. Через HTTP-прокси в столбце виден адрес прокси.
Имена из DoH и DoT не разбираются: такой TCP-адрес помечается как direct.
EOF
}

expand_fqdn_path() {
  local path="$1" dir base
  if [[ "$path" == "~" ]]; then
    path="$HOME"
  elif [[ "$path" == "~/"* ]]; then
    path="$HOME/${path:2}"
  fi
  dir=$(dirname -- "$path")
  base=$(basename -- "$path")
  if [[ -z "$base" || "$base" == "." || "$base" == ".." ]]; then
    echo "ключ -o требует путь к файлу" >&2
    exit 1
  fi
  if [[ ! -d "$dir" ]]; then
    echo "нет каталога для -o: $dir" >&2
    exit 1
  fi
  if [[ -d "$path" ]]; then
    echo "ключ -o указывает на каталог: $path" >&2
    exit 1
  fi
  dir=$(cd -- "$dir" && pwd)
  printf '%s\n' "$dir/$base"
}

prepare_fqdn_file() {
  [[ -n "$fqdn_file" ]] || return 0
  if [[ -e "$fqdn_file" && ! -f "$fqdn_file" ]]; then
    echo "ключ -o не обычный файл: $fqdn_file" >&2
    exit 1
  fi
  : > "$fqdn_file"
  chmod 600 "$fqdn_file"
  if [[ "$(id -u)" -eq 0 && -n "${SUDO_UID:-}" ]]; then
    chown "${SUDO_UID}:${SUDO_GID:-}" "$fqdn_file"
  fi
}

# Разбор текстовых строк tcpdump. Данные приходят на stdin.
# OUTBOUND_ONLY=1: каждая строка уже исходящая (фильтр --direction=out).
# Иначе исходящим считается пакет с локального адреса из LOCAL_FILE.
run_awk() {
  FQDN_FILE="$fqdn_file" \
  LOCAL_FILE="$local_file" \
  OUTBOUND_ONLY="$use_direction" \
  "$AWK" '
function load_own(   line) {
  delete own
  if (local_file == "") return
  while ((getline line < local_file) > 0) {
    if (line != "") own[tolower(line)] = 1
  }
  close(local_file)
}

function peer(token,   n, i, p, ip) {
  sub(/:$/, "", token)
  if (token !~ /\.[0-9]+$/) return ""
  n = split(token, p, ".")
  if (n < 2 || p[n] !~ /^[0-9]+$/) return ""
  ip = p[1]
  for (i = 2; i < n; i++) ip = ip "." p[i]
  return tolower(ip)
}

function side_ip(line, which,   left, right, n, a, token) {
  if (!match(line, / > /)) return ""
  if (which == "dst") {
    right = substr(line, RSTART + 3)
    if (!match(right, /^[^ \t]+/)) return ""
    token = substr(right, RSTART, RLENGTH)
  } else {
    left = substr(line, 1, RSTART - 1)
    n = split(left, a, /[ \t]+/)
    token = a[n]
  }
  return peer(token)
}

function tcp_syn_noack(line,   flags) {
  if (!match(line, /Flags \[[^]]+\]/)) return 0
  flags = substr(line, RSTART + 7, RLENGTH - 8)
  return (flags ~ /[Ss]/ && flags !~ /\./)
}

function skip_dest(ip) {
  if (ip == "" || ip == "0.0.0.0" || ip == "::") return 1
  if (ip ~ /^127\./ || ip ~ /^0\./) return 1
  if (ip ~ /^(22[4-9]|23[0-9])\./) return 1
  if (ip == "255.255.255.255" || ip == "::1") return 1
  if (ip ~ /^ff[0-9a-f][0-9a-f]:/) return 1
  if (ip ~ /:ffff:127\./) return 1
  if (ip in own) return 1
  return 0
}

function packet_from_us(line,   src) {
  if (outbound_only) return 1
  src = side_ip(line, "src")
  return (src != "" && (src in own))
}

function bad_name_char(name,   i, c, n) {
  n = length(name)
  for (i = 1; i <= n; i++) {
    c = substr(name, i, 1)
    if (c < " " || c == "\177") return 1
    if (c == " " || c == "/" || c == "\\" || c == "?" || c == "#" || c == "@" || c == ":") return 1
  }
  return 0
}

function good_fqdn(raw,   name, n, i, lab, labels) {
  name = tolower(raw)
  sub(/\.$/, "", name)
  if (length(name) < 3 || length(name) > 253) return ""
  if (index(name, "..") > 0 || substr(name, 1, 1) == ".") return ""
  if (name ~ /\.arpa$/) return ""
  if (bad_name_char(name)) return ""
  n = split(name, labels, ".")
  if (n < 2) return ""
  if (name ~ /^[a-z0-9_.-]+$/) {
    for (i = 1; i <= n; i++) {
      lab = labels[i]
      if (lab == "" || length(lab) > 63) return ""
      if (substr(lab, 1, 1) == "-" || substr(lab, length(lab), 1) == "-") return ""
    }
    return name
  }
  for (i = 1; i <= n; i++) if (labels[i] == "") return ""
  return name
}

function remember_ip(ip) {
  if (ip in seen_ip) return
  seen_ip[ip] = 1
  print ip
  fflush()
}

function dns_id(token) {
  if (match(token, /^[0-9]+/)) return substr(token, RSTART, RLENGTH)
  return ""
}

function normalize_ip(token,   ip, n, p, i, v) {
  sub(/,$/, "", token)
  sub(/\.$/, "", token)
  ip = tolower(token)
  if (ip ~ /^([0-9]+\.){3}[0-9]+$/) {
    n = split(ip, p, ".")
    for (i = 1; i <= 4; i++) {
      v = p[i] + 0
      if (v < 0 || v > 255) return ""
    }
    return ip
  }
  if (index(ip, ":") > 0 && ip ~ /^[0-9a-f:]+$/ && index(ip, ":::") == 0) return ip
  return ""
}

function rewrite(   i) {
  if (fqdn_file == "") return
  close(fqdn_file)
  if (nrec == 0) {
    printf "" > fqdn_file
    close(fqdn_file)
    return
  }
  for (i = 1; i <= nrec; i++) print rec[i] > fqdn_file
  fflush(fqdn_file)
  close(fqdn_file)
}

function remove_direct(ip,   i, n, parts) {
  if (!(ip in is_direct)) return
  delete is_direct[ip]
  n = 0
  for (i = 1; i <= nrec; i++) {
    split(rec[i], parts, "\t")
    if (parts[1] == "direct" && parts[3] == ip) continue
    n++
    kept[n] = rec[i]
  }
  for (i = 1; i <= n; i++) rec[i] = kept[i]
  for (i = n + 1; i <= nrec; i++) delete rec[i]
  nrec = n
  delete kept
}

function add_dns(name, ip,   key) {
  key = name SUBSEP ip
  if (key in seen_dns) return
  seen_dns[key] = 1
  is_resolved[ip] = 1
  if (ip in is_direct) remove_direct(ip)
  nrec++
  rec[nrec] = "dns\t" name "\t" ip
  rewrite()
}

function add_direct(ip) {
  if (ip in is_resolved || ip in is_direct) return
  is_direct[ip] = 1
  nrec++
  rec[nrec] = "direct\t-\t" ip
  rewrite()
}

function harvest_dns(line,   n, i, j, a, id, name, ip) {
  n = split(line, a, /[ \t]+/)
  if (us) {
    for (i = 1; i <= n; i++) {
      if (a[i] !~ /^[0-9]+\+/) continue
      id = dns_id(a[i])
      j = i + 1
      while (j <= n && a[j] ~ /^\[/) j++
      if (j < n && a[j] ~ /^[A-Za-z][A-Za-z0-9]*\?$/) {
        name = good_fqdn(a[j + 1])
        if (id != "" && name != "") qname[id] = name
      }
    }
  }
  for (i = 1; i < n; i++) {
    if (a[i] ~ /\+/ || a[i] !~ /^[0-9]+[*-]*$/) continue
    if (a[i + 1] !~ /^[0-9]+\/[0-9]+\/[0-9]+$/) continue
    id = dns_id(a[i])
    name = qname[id]
    if (name == "") continue
    for (j = i + 2; j < n; j++) {
      if ((a[j] == "A" || a[j] == "AAAA") && (ip = normalize_ip(a[j + 1])) != "") add_dns(name, ip)
    }
  }
}

BEGIN {
  fqdn_file = ENVIRON["FQDN_FILE"]
  local_file = ENVIRON["LOCAL_FILE"]
  outbound_only = ENVIRON["OUTBOUND_ONLY"] + 0
}

{
  load_own()
  us = packet_from_us($0)
  harvest_dns($0)
  if (tcp_syn_noack($0)) {
    dst = side_ip($0, "dst")
    if (dst != "" && !skip_dest(dst) && (outbound_only || us)) {
      remember_ip(dst)
      add_direct(dst)
    }
  }
}
'
}

expect_eq() {
  local title="$1" want="$2" got="$3"
  if [[ "$want" != "$got" ]]; then
    printf 'проверка не пройдена: %s\nожидалось:\n%s\nполучено:\n%s\n' "$title" "$want" "$got" >&2
    exit 1
  fi
}

